# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
package-lock.json
backend/package-lock.json
frontend/package-lock.json
dist/
frontend/dist/
.vite/

# Environment configuration & sensitive secrets
config.env
backend/config.env
*.env
.env
.env.*
